<?xml version="1.0"
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="FrameLayout 실습"
        android:textColor="#8BC34A"
        android:textStyle="bold"
        android:textSize="20sp"
        android:layout_marginBottom="25dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <FrameLayout
                android:layout_width="160dp"
                android:layout_height="240dp"
                android:layout_marginBottom="50dp">

                <!-- 캐릭터 착용 목걸이 (위치/크기 유지) -->

                <ImageView
                    android:id="@+id/ivobjBody"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:src="@drawable/body" />

                <ImageView
                    android:id="@+id/ivobjDress"
                    android:layout_width="140dp"
                    android:layout_height="140dp"
                    android:layout_gravity="bottom|center_horizontal"
                    android:layout_marginBottom="5dp"
                    android:visibility="invisible" />

                <ImageView android:id="@+id/ivobjNecklace" android:layout_width="65dp" android:layout_height="65dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="70dp" android:visibility="invisible" />

                <!-- 캐릭터 착용 왕관 (위치/크기 유지) -->
                <ImageView android:id="@+id/ivobjCrown" android:layout_width="85dp" android:layout_height="85dp" android:layout_gravity="top|center_horizontal" android:layout_marginTop="-20dp" android:visibility="invisible" />
            </FrameLayout>

            <!-- 👑 왕관 선택 메뉴: 80dp 적용 (가로 공간에 맞게 여백을 10dp로 조정) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="15dp">
                <ImageView android:id="@+id/imageViewCrown1" android:layout_width="80dp" android:layout_height="80dp" android:layout_marginEnd="10dp" android:src="@drawable/crown1" android:onClick="onClickChoice" />
                <ImageView android:id="@+id/imageViewCrown2" android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/crown2" android:onClick="onClickChoice" />
            </LinearLayout>

            <!-- 💍 목걸이 선택 메뉴: 80dp 적용 -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView android:id="@+id/imageViewNecklace1" android:layout_width="80dp" android:layout_height="80dp" android:src="@drawable/necklace1" android:onClick="onClickChoice" />
            </LinearLayout>
        </LinearLayout>

        <!-- 오른쪽 영역: 드레스 3종 -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center">

            <ImageView
                android:id="@+id/imageViewDress1"
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_marginBottom="50dp"
                android:onClick="onClickChoice"
                android:src="@drawable/dress1" />

            <ImageView android:id="@+id/imageViewDress2" android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/dress2" android:layout_marginBottom="50dp" android:onClick="onClickChoice" />
            <ImageView android:id="@+id/imageViewDress3" android:layout_width="150dp" android:layout_height="150dp" android:src="@drawable/dress3" android:onClick="onClickChoice" />
        </LinearLayout>

    </LinearLayout>

    <!-- 하단 다시하기 버튼 -->
    <Button
        android:id="@+id/btnReset"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_marginTop="10dp"
        android:backgroundTint="#00BCD4"
        android:text="다시하기"
        android:textColor="#FFFFFF"
        android:textSize="16sp" />

</LinearLayout>